+}
+
+UNICORN_EXPORT
+uc_err uc_emu_budget_query(uc_engine *uc, uint64_t *counter, uint64_t *limit,
+                           uint32_t *active)
+{
+    if (!uc || !counter || !limit || !active) {
+        return UC_ERR_ARG;
+    }
+    *counter = uc->emu_counter;
+    *limit = uc->emu_count;
+    *active = uc->nested_level > 0 && !uc->emulation_done && !uc->stop_request;
+    return UC_ERR_OK;
+}
+
+UNICORN_EXPORT
+uc_err uc_emu_budget_consume(uc_engine *uc, uint64_t additional,
+                             uint32_t *accepted)
+{
+    if (!uc || !accepted) {
+        return UC_ERR_ARG;
+    }
+    *accepted = 0;
+    if (uc->nested_level == 0 || uc->emulation_done || uc->stop_request) {
+        return UC_ERR_OK;
+    }
+    if (uc->emu_count != 0) {
+        if (uc->emu_counter > uc->emu_count ||
+            additional > (uint64_t)(uc->emu_count - uc->emu_counter)) {
+            return UC_ERR_OK;
+        }
+        uc->emu_counter += (size_t)additional;
+    }
+    *accepted = 1;
+    return UC_ERR_OK;
 }
 
