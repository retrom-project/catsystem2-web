             uc->nested_level--;
             return err;
         }
+        // Blocks translated while count was zero have no budget checks.
+        // Remove them when enabling counting, as when disabling it above.
+        uc->tb_flush(uc);
     }
 
     // If UC_CTL_UC_USE_EXITS is set, then the @until param won't have any
@@ -1330,6 +1333,41 @@
     uc_err err = break_translation_loop(uc);
