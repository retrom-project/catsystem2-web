 /*
+ Read the instruction counter of the current uc_emu_start segment. The counter
+ already includes the instruction whose code hook is running. A zero limit is
+ uncounted. Active is zero outside emulation and after a stop request.
+ This read-only API does not initialize the CPU or alter its execution state.
+*/
+UNICORN_EXPORT
+uc_err uc_emu_budget_query(uc_engine *uc, uint64_t *counter, uint64_t *limit,
+                           uint32_t *active);
+
+/*
+ Atomically account for additional instructions simulated by a host code hook.
+ If the active counted segment cannot accommodate the whole amount, or is idle
+ or stopping, accepted is zero and no counter, CPU or guest memory is changed.
+ An active uncounted segment accepts without changing its unused counter.
+ Call only on the emulation thread; this function never yields or resumes it.
+*/
+UNICORN_EXPORT
+uc_err uc_emu_budget_consume(uc_engine *uc, uint64_t additional,
+                             uint32_t *accepted);
+
