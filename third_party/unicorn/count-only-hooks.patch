 #include "uc_priv.h"
 #include "tcg/tcg-apple-jit.h"
 
+/* The internal counter returns without changing any CPU global. When the
+ * exact limit is exceeded it exits instead, after materializing the lazy CC
+ * operation and current instruction PC supplied by the translator. */
+void HELPER(uc_count)(CPUX86State *env, uint64_t pc, uint32_t cc_op)
+{
+    uc_engine *uc = env->uc;
+    if (++uc->emu_counter > uc->emu_count) {
+        if (cc_op != CC_OP_DYNAMIC) {
+            env->cc_op = cc_op;
+        }
+        env->eip = pc;
+        uc->skip_sync_pc_on_exit = true;
+        uc_emu_stop(uc);
+        HELPER(check_exit_request)(uc, 0);
+    }
+}
