+static void tcg_out_uc_budget(TCGContext *s, const TCGOp *op)
+{
+    uint8_t *begin = s->code_ptr;
+    uint8_t *length_at;
+    uint8_t *count_at;
+    unsigned int count = 0;
+    int i;
+    tcg_out8(s, INDEX_op_uc_budget);
+    tcg_out8(s, 0);  /* Extended bytecode length follows. */
+    length_at = s->code_ptr;
+    tcg_out32(s, 0);
+    tcg_out_i(s, op->args[0]);
+    tcg_out32(s, op->args[1]);
+    tcg_out32(s, op->args[2]);
+    tcg_out32(s, op->args[3]);
+    tcg_out_i(s, op->args[4]);
+    count_at = s->code_ptr;
+    tcg_out32(s, 0);
+    for (i = 0; i < s->nb_globals; i++) {
+        TCGTemp *ts = &s->temps[i];
+        if (ts->fixed_reg || ts->mem_coherent || ts->val_type == TEMP_VAL_MEM) {
+            continue;
+        }
+        tcg_debug_assert(ts->mem_allocated && ts->mem_base);
+        tcg_debug_assert(ts->val_type == TEMP_VAL_REG || ts->val_type == TEMP_VAL_CONST);
+        tcg_out32(s, ts->mem_offset);
+        tcg_out8(s, ts->mem_base->reg);
+        tcg_out8(s, ts->type == TCG_TYPE_I64 ? 8 : 4);
+        tcg_out8(s, ts->val_type == TEMP_VAL_CONST);
+        if (ts->val_type == TEMP_VAL_CONST) {
+            tcg_out_i(s, ts->val);
+        } else {
+            tcg_out8(s, ts->reg);
+        }
+        count++;
+    }
+    *(uint32_t *)length_at = s->code_ptr - begin;
+    *(uint32_t *)count_at = count;
+}
