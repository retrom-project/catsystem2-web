+/* Softfloat keeps sticky SSE flags separately from the control word. */
+static inline uint32_t cpu_get_mxcsr(CPUX86State *env)
+{
+    int flags = env->sse_status.float_exception_flags;
+    uint32_t status = flags & 0x3d;
+    if ((flags & float_flag_input_denormal) && !(env->mxcsr & 0x40)) {
+        status |= 0x02;
+    }
+    if (flags & float_flag_output_denormal) {
+        status |= 0x30;
+    }
+    return env->mxcsr | status;
+}
+
 static inline void cpu_set_mxcsr(CPUX86State *env, uint32_t mxcsr)
 {
     env->mxcsr = mxcsr;
