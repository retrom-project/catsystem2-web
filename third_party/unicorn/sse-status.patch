+/* Denormal operands are reported by SSE arithmetic even when DAZ is off.
+ * Softfloat's input-denormal flag otherwise only records flushed inputs. */
+static inline void x86_sse_denormal32(CPUX86State *env, float32 a, float32 b)
+{
+    if (!(env->mxcsr & 0x40) && !float32_is_any_nan(a) &&
+        !float32_is_any_nan(b) &&
+        (float32_is_denormal(a) || float32_is_denormal(b))) {
+        env->sse_status.float_exception_flags |= float_flag_input_denormal;
+    }
+}
+
+static inline void x86_sse_denormal64(CPUX86State *env, float64 a, float64 b)
+{
+    if (!(env->mxcsr & 0x40) && !float64_is_any_nan(a) &&
+        !float64_is_any_nan(b) &&
+        (float64_is_denormal(a) || float64_is_denormal(b))) {
+        env->sse_status.float_exception_flags |= float_flag_input_denormal;
+    }
+}
+
+#define FPU_DENORMAL(size, a, b) x86_sse_denormal ## size(env, a, b)
+#define FPU_ADD(size, a, b) \
+    (FPU_DENORMAL(size, a, b), float ## size ## _add(a, b, &env->sse_status))
+#define FPU_SUB(size, a, b) \
+    (FPU_DENORMAL(size, a, b), float ## size ## _sub(a, b, &env->sse_status))
+#define FPU_MUL(size, a, b) \
+    (FPU_DENORMAL(size, a, b), float ## size ## _mul(a, b, &env->sse_status))
+#define FPU_DIV(size, a, b) \
+    ((float ## size ## _is_zero(b) ? (void)0 : FPU_DENORMAL(size, a, b)), \
+     float ## size ## _div(a, b, &env->sse_status))
+#define FPU_SQRT(size, a, b) \
+    ((float ## size ## _is_neg(b) ? (void)0 : FPU_DENORMAL(size, b, b)), \
