{
  "name": "catsystem2-web",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-no-exe-addresses.mjs && node scripts/check-native-entry.mjs && node scripts/check-calculation-boundary.mjs && node scripts/test-native.mjs --check-plan && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:browser": "playwright test",
    "test:game": "playwright test --config playwright.game.config.mjs",
    "test:native-game": "playwright test --config playwright.native-game.config.mjs",
    "test:native-sdk": "playwright test --config playwright.native-sdk.config.mjs",
    "test": "node scripts/test-native.mjs",
    "corpus": "node scripts/corpus.mjs",
    "prepare:media": "node scripts/prepare-media.mjs",
    "test:route": "playwright test --config playwright.route.config.mjs",
    "test:js": "node scripts/test-native.mjs --group js",
    "test:oracle": "node scripts/test-native.mjs --group oracle",
    "test:differential": "node scripts/test-native.mjs --group differential",
    "test:full": "node scripts/test-native.mjs --require-fixtures"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.61.1",
    "eslint": "9.39.0",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  }
}
